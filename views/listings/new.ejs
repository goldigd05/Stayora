<% layout("./layouts/boilerplate") %>

    <body>

        <div class="row">
            <div class="col-8 offset-2">
                <br>
                <br>
                <h1>Welcome, Create New Listings</h1>
                <br>
                <form method="POST" action="/listings" novalidate class="needs-validation">
                    <!-- non validate jo hai vo defualt setting ko  validon ki browser wali hta rha hai  -->
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input name="listing[title]" type="text" class="form-control " required>
                        <div class="valid-feedback">
                            Title looks good
                        </div>
                        <div class="invalid-feedback">
                            please enter title
                        </div>

                    </div>
                    <div class="mb-3"><label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" type="text" class="form-control " required></textarea>
                        <div class="valid-feedback">
                            Description is lookes detailed
                        </div>
                        <div class="invalid-feedback">
                            please enter detailed description
                        </div>

                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Image URL</label>
                        <input name="listing[image]" type="text" class="form-control ">
                        <div class="valid-feedback">
                            Image URl added
                        </div>
                        <div class="invalid-feedback">
                            please enter image link address
                        </div>

                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input name="listing[price]" class="form-control" required>
                            <div class="valid-feedback">
                                Price is looks real
                            </div>
                            <div class="invalid-feedback">
                                please enter valid price
                            </div>
                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input name="listing[country]" type="text" class="form-control " required>

                            <div class="invalid-feedback">
                                please enter country name
                            </div>

                        </div>
                    </div>

                    <div class="mb-3"><label for="location" class="form-label">Location</label>
                        <input name="listing[location]" type="text" class="form-control" required>
                        <div class="invalid-feedback">
                            please enter your location
                        </div>
                    </div>
                    <br>
                    <button class="btn btn-dark add-btn">Add</button>
                    <br>
                    <br>
                </form>

            </div>
        </div>
    </body>